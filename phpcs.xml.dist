<?xml version="1.0"?>
<ruleset name="random-page-redirect-for-wordpress">
    <description>WordPress-Extra ruleset for Random Page Redirect for WordPress.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="random-page-redirect-for-wordpress"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="thisismyurl_random"/>
                <element value="Random_Page_Redirect"/>
            </property>
        </properties>
    </rule>
</ruleset>
